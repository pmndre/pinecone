# Paths on this Mac. The first start copies this file to ~/.pinecone/.env; config.json uses the names as $NAME.
# Any path works. By convention models are kept in ~/.pinecone/models and services in ~/.pinecone/services
# (docs/setup.md); write the paths out in full, a ~ is not replaced.
LLAMA_SERVER=/path/to/llama.cpp/build/bin/llama-server
MODELS=/path/to/your/models
COMFY=/path/to/ComfyUI
AUDIO=/path/to/mlx-audio
